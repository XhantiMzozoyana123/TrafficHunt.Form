# Copy to `.env` (repository root) and fill in real values.
#
# docker-compose.yml interpolates ${VAR:-default} from this file, and the service
# `environment:` block overrides anything set in docker/.env. Without this file the
# values below fall back to the defaults baked into docker-compose.yml.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# SQLite database file; lives in the traffichunt-web-data volume at /app/App_Data.
CONNECTION_STRING=Data Source=App_Data/traffichunt.db

# YouTube Data API key used to read comments.
YOUTUBE_API_KEY=REPLACE_ME

# LLM endpoint. Use the bundled container (started by `docker compose up`) or an
# external Ollama server.
LLM_URL=http://ollama:11434/api/generate
LLM_MODEL=llama3:latest

# Only needed if you start the (currently unused) mysql service.
MYSQL_DATABASE=traffichuntdb
MYSQL_USER=traffichunt
MYSQL_PASSWORD=ChangeMeStrong!
MYSQL_ROOT_PASSWORD=ChangeMeStrong!
