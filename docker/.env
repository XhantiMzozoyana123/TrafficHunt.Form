ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# SQLite (Web app) — database file is stored in the traffichunt-web-data volume
# at /app/App_Data/traffichunt.db inside the container.
CONNECTION_STRING=Data Source=App_Data/traffichunt.db

# YouTube
YOUTUBE_API_KEY=REPLACE_ME

# LLM (Ollama)
LLM_URL=http://ollama:11434/api/generate
LLM_MODEL=llama3:latest
