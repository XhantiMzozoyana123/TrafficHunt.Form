@model List<Comment>
@{
    ViewData["Title"] = "Comment finder";

    var defaultPrompt = (string?)ViewData["DefaultPrompt"] ?? string.Empty;
    var defaultReplyPrompt = (string?)ViewData["DefaultReplyPrompt"] ?? string.Empty;

    // Every button on this page is a form POST that redirects back here, so the messages and the
    // values the actions remembered all arrive in TempData (no client-side JavaScript anywhere).
    var status = (string?)TempData["Status"];
    var fetchError = (string?)TempData["FetchError"];
    var qualifyError = (string?)TempData["QualifyError"];
    var replyError = (string?)TempData["ReplyError"];

    var fetchKeyword = (string?)TempData["FetchKeyword"] ?? string.Empty;
    int.TryParse((string?)TempData["FetchMaxVideos"], out var fetchMaxVideos);
    int.TryParse((string?)TempData["FetchMaxComments"], out var fetchMaxComments);
    if (fetchMaxVideos <= 0) { fetchMaxVideos = 3; }
    if (fetchMaxComments <= 0) { fetchMaxComments = 20; }
    var fetchOrder = (string?)TempData["FetchOrder"] ?? "relevance";

    var qualifyPrompt = (string?)TempData["QualifyPrompt"] ?? defaultPrompt;
    var bulkReplyPrompt = (string?)TempData["BulkReplyPrompt"] ?? defaultReplyPrompt;
    var replyPrompt = (string?)TempData["ReplyPrompt"] ?? defaultReplyPrompt;
    var draftedReply = (string?)TempData["DraftedReply"] ?? string.Empty;
    var selectedCommentId = (string?)TempData["DraftCommentId"] ?? string.Empty;

    var composerClass = string.IsNullOrEmpty(selectedCommentId) ? "card mb-3" : "card mb-3 border-primary";
}

<h1 class="h4 mb-3">Comment finder</h1>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert alert-success py-2">@status</div>
}
@if (!string.IsNullOrEmpty(fetchError))
{
    <div class="alert alert-danger py-2">@fetchError</div>
}
@if (!string.IsNullOrEmpty(qualifyError))
{
    <div class="alert alert-danger py-2">@qualifyError</div>
}
@if (!string.IsNullOrEmpty(replyError))
{
    <div class="alert alert-danger py-2">@replyError</div>
}

<div class="alert alert-secondary status-strip py-2">
    @(Model.Count) comment(s) loaded from traffichuntdb.
</div>

<div class="row g-3 mb-3">
    <!-- Step 1: fetch -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 fw-semibold mb-3">Step 1 &mdash; Fetch comments</h2>
                <form asp-action="Fetch" method="post" class="row g-2">
                    <div class="col-12">
                        <input type="text" class="form-control" id="keyword" name="keyword" value="@fetchKeyword"
                               placeholder="Keyword, e.g. traffic leads for contractors" required />
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="maxVideos">Videos</label>
                        <input type="number" class="form-control" id="maxVideos" name="maxVideos"
                               value="@fetchMaxVideos" min="1" max="25" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="maxComments">Comments per video</label>
                        <input type="number" class="form-control" id="maxComments" name="maxComments"
                               value="@fetchMaxComments" min="1" max="100" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-1" for="order">Order</label>
                        <select class="form-select" id="order" name="order">
                            @if (fetchOrder == "time")
                            {
                                <option value="relevance">Relevance</option>
                                <option value="time" selected>Newest</option>
                            }
                            else
                            {
                                <option value="relevance" selected>Relevance</option>
                                <option value="time">Newest</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Get comments</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Step 2: AI qualify -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 fw-semibold mb-3">Step 2 &mdash; AI qualify</h2>
                <p class="text-muted small mb-2">
                    Sends the whole list to the AI as one JSON payload and keeps only the matches.
                    Removed comments stay gone until the next fetch.
                </p>
                <form asp-action="AiQualify" method="post">
                    <div class="mb-2">
                        <label class="form-label small mb-1" for="qualifyPrompt">AI prompt &mdash; what kind of comment should be kept?</label>
                        <textarea class="form-control" id="qualifyPrompt" name="prompt" rows="3">@qualifyPrompt</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">AI qualify</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Step 3: reply to one comment -->
<div class="@composerClass" id="reply-composer">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Step 3 &mdash; Reply to one comment</h2>
        <p class="text-muted small mb-2">
            Pick a comment below, or press the Reply button on a table row to load that comment here.
            Draft the reply with the AI, edit it if you like, then send it to YouTube.
        </p>
        <form asp-action="SendReply" method="post" class="row g-2">
            <div class="col-lg-6">
                <label class="form-label small mb-1" for="replyCommentId">Comment</label>
                <select class="form-select" id="replyCommentId" name="commentId" required>
                    @if (string.IsNullOrEmpty(selectedCommentId))
                    {
                        <option value="" selected disabled>&mdash; pick a comment &mdash;</option>
                    }
                    else
                    {
                        <option value="" disabled>&mdash; pick a comment &mdash;</option>
                    }
                    @foreach (var comment in Model)
                    {
                        var preview = (comment.CommentText ?? string.Empty)
                            .Replace("\r", " ").Replace("\n", " ").Trim();

                        if (preview.Length > 80)
                        {
                            preview = preview.Substring(0, 80) + "...";
                        }

                        if (comment.CommentId == selectedCommentId)
                        {
                            <option value="@comment.CommentId" selected>@comment.AuthorName &mdash; @preview</option>
                        }
                        else
                        {
                            <option value="@comment.CommentId">@comment.AuthorName &mdash; @preview</option>
                        }
                    }
                </select>
                @if (Model.Count == 0)
                {
                    <div class="form-text">Nothing to reply to yet &mdash; fetch comments in Step 1 first.</div>
                }
            </div>
            <div class="col-lg-6">
                <label class="form-label small mb-1" for="replyPrompt">AI reply prompt &mdash; how should the AI respond?</label>
                <textarea class="form-control" id="replyPrompt" name="prompt" rows="3">@replyPrompt</textarea>
            </div>
            <div class="col-12">
                <label class="form-label small mb-1" for="replyText">Your reply</label>
                <textarea class="form-control" id="replyText" name="replyText" rows="4"
                          placeholder="Draft one with the AI, or write it yourself, then press Send reply.">@draftedReply</textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-outline-primary"
                        formaction="@Url.Action("DraftReply", "Comments")">Draft AI reply</button>
                <button type="submit" class="btn btn-success">Send reply</button>
            </div>
        </form>
    </div>
</div>

<!-- Step 4: bulk AI auto-reply -->
<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Step 4 &mdash; AI auto-reply to every pending comment</h2>
        <p class="text-muted small mb-2">
            Generates a reply for every comment without one and sends it to YouTube, then saves it in
            traffichuntdb. This can take a while, so the page only reloads when the run is finished.
        </p>
        <form asp-action="AiReplyAll" method="post">
            <div class="mb-2">
                <label class="form-label small mb-1" for="bulkReplyPrompt">AI reply prompt &mdash; how should the AI respond and what should it say?</label>
                <textarea class="form-control" id="bulkReplyPrompt" name="prompt" rows="3">@bulkReplyPrompt</textarea>
            </div>
            <button type="submit" class="btn btn-success">AI reply to all pending</button>
        </form>
    </div>
</div>

<!-- Comments -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Author</th>
                    <th>Comment</th>
                    <th>Video</th>
                    <th>Posted</th>
                    <th class="text-end">Likes</th>
                    <th>Reply</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var number = 1;
                }
                @foreach (var comment in Model)
                {
                    <tr>
                        <td>@(number++)</td>
                        <td>@comment.AuthorName</td>
                        <td class="comment-cell">@comment.CommentText</td>
                        <td>@comment.VideoTitle</td>
                        <td>@(comment.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="text-end">@comment.LikeCount.ToString("N0")</td>
                        <td class="reply-cell">
                            @if (!string.IsNullOrWhiteSpace(comment.ReplyText))
                            {
                                <span title="Replied @(comment.RepliedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))">@comment.ReplyText</span>
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" title="Open on YouTube"
                               href="https://www.youtube.com/watch?v=@comment.VideoId&lc=@comment.CommentId"
                               target="_blank" rel="noopener">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                            <form asp-action="SelectForReply" method="post" class="d-inline">
                                <input type="hidden" name="commentId" value="@comment.CommentId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Reply to this comment">
                                    <i class="bi bi-reply"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="commentId" value="@comment.CommentId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete from traffichuntdb">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No comments to show. Type a keyword in Step 1 and press "Get comments".
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
